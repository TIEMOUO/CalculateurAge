<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"></Label>
            <Entry x:Name="entryNom" Placeholder="Votre nom"></Entry>
            <Label Text="Date de naissance " FontSize="16"></Label>
            <DatePicker x:Name="pickerDate"></DatePicker>
            <Button x:Name="BtnCalculer" Text="Calculer"
                    Clicked="OnCalculerClicked">
            </Button>
            <Label x:Name="lblResultat" FontSize="20" IsVisible="False"></Label>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
